# Copy to .env and fill in real values. Never commit .env.

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset for local SQLite. Production example:
# DATABASE_URL=postgres://carely:password@localhost:5432/carely

# Folder for uploaded lab reports (kept private, outside any public URL).
# MEDIA_ROOT=/var/lib/carely/media

# Password given to the fake demo users created by `python manage.py seed_demo`.
DEMO_PASSWORD=change-me-demo-password
